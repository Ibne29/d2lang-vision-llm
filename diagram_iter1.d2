direction: right

pipeline: {
  shape: rectangle
  style.stroke-width: 2
  style.stroke-dash: 2
  style.fill: "#f0f0f0"

  input: "Documentation D2lang" {
    shape: document
    style.fill: "#e6f7ff"
  }

  rag: "RAG" {
    shape: cylinder
    style.fill: "#fff2e6"
  }

  mistral: "Codestral (Mistral)" {
    shape: hexagon
    style.fill: "#e6ffe6"
  }

  pixtral: "Pixtral (Vision LLM)" {
    shape: parallelogram
    style.fill: "#ffe6f7"
  }

  output: "Diagramme D2" {
    shape: document
    style.fill: "#e6f7ff"
  }

  input -> rag -> mistral -> output
  rag -> pixtral
  pixtral -> output
}

legend: {
  shape: rectangle
  style.stroke-width: 0
  style.fill: "#ffffff"

  "Documentation D2lang": {
    shape: document
    style.fill: "#e6f7ff"
  }

  "RAG": {
    shape: cylinder
    style.fill: "#fff2e6"
  }

  "Codestral (Mistral)": {
    shape: hexagon
    style.fill: "#e6ffe6"
  }

  "Pixtral (Vision LLM)": {
    shape: parallelogram
    style.fill: "#ffe6f7"
  }

  "Diagramme D2": {
    shape: document
    style.fill: "#e6f7ff"
  }
}