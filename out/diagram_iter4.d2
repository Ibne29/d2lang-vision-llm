direction: right

# Pipeline de génération de diagrammes D2

## Modèle de langage Mistral (Codestral)
codestral: {
  shape: rectangle
  label: "Modèle de langage\nMistral (Codestral)"
  style: {
    fill: "#f0f8ff"
    stroke: "#4682b4"
    stroke-width: 2
  }
}

## RAG avec documentation officielle D2lang
rag: {
  shape: cylinder
  label: "RAG avec documentation\nofficielle D2lang"
  style: {
    fill: "#e6e6fa"
    stroke: "#9370db"
    stroke-width: 2
  }
}

## Modèle Vision LLM (Pixtral)
pixtral: {
  shape: hexagon
  label: "Modèle Vision LLM\n(Pixtral)"
  style: {
    fill: "#fff0f5"
    stroke: "#ff69b4"
    stroke-width: 2
  }
}

## Entrée utilisateur
entree: {
  shape: parallelogram
  label: "Entrée utilisateur\n(texte D2)"
  style: {
    fill: "#f5f5dc"
    stroke: "#8b4513"
    stroke-width: 2
  }
}

## Diagramme généré
diagramme: {
  shape: rectangle
  label: "Diagramme généré"
  style: {
    fill: "#e0ffff"
    stroke: "#00ced1"
    stroke-width: 2
  }
}

## Vérification visuelle
verification: {
  shape: diamond
  label: "Vérification visuelle"
  style: {
    fill: "#f0fff0"
    stroke: "#32cd32"
    stroke-width: 2
  }
}

## Sortie finale
sortie: {
  shape: parallelogram
  label: "Sortie finale\n(diagramme validé)"
  style: {
    fill: "#f5f5dc"
    stroke: "#8b4513"
    stroke-width: 2
  }
}

# Connexions
entree -> codestral: "Texte D2"
codestral -> rag: "Requête"
rag -> codestral: "Contexte enrichi"
codestral -> diagramme: "Génération"
diagramme -> pixtral: "Image générée"
pixtral -> verification: "Analyse"
verification -> diagramme: "Retour si incohérent"
verification -> sortie: "Validation"