api-gateway: {
  shape: rectangle
  label: "API Gateway"
}

auth-service: {
  shape: rectangle
  label: "Auth Service"
}

orders-service: {
  shape: rectangle
  label: "Orders Service"
}

payments-service: {
  shape: rectangle
  label: "Payments Service"
}

auth-db: {
  shape: cylinder
  label: "Auth DB"
}

orders-db: {
  shape: cylinder
  label: "Orders DB"
}

payments-db: {
  shape: cylinder
  label: "Payments DB"
}

client: {
  shape: person
  label: "Client"
}

client -> api-gateway: "Requests"
api-gateway -> auth-service: "Auth Requests"
api-gateway -> orders-service: "Order Requests"
api-gateway -> payments-service: "Payment Requests"
auth-service -> auth-db: "Storage"
orders-service -> orders-db: "Storage"
payments-service -> payments-db: "Storage"