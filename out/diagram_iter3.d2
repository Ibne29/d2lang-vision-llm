direction: right

# Pipeline de traduction automatique de documents médicaux
pipeline: {
  shape: rectangle
  style.stroke: blue
  style.fill: lightblue
  style.stroke-width: 2
}

# Modèles de langage pré-entraînés (LLM)
llm: {
  shape: ellipse
  style.stroke: green
  style.fill: lightgreen
  style.stroke-width: 2
  label: "Modèles de langage pré-entraînés (LLM)"
}

# Techniques de post-traitement
post_processing: {
  shape: ellipse
  style.stroke: orange
  style.fill: lightorange
  style.stroke-width: 2
  label: "Techniques de post-traitement"
}

# Évaluations humaines
human_evaluation: {
  shape: ellipse
  style.stroke: purple
  style.fill: lightpurple
  style.stroke-width: 2
  label: "Évaluations humaines"
}

# Flux de processus
pipeline -> llm: "Générer des traductions initiales"
llm -> post_processing: "Améliorer les traductions"
post_processing -> human_evaluation: "Évaluer la qualité des traductions"
human_evaluation -> pipeline: "Feedback pour amélioration continue"

# Modèle de langage Mistral (Codestral)
mistral: {
  shape: ellipse
  style.stroke: darkblue
  style.fill: lightblue
  style.stroke-width: 2
  label: "Modèle de langage Mistral (Codestral)"
}

# RAG alimenté par la documentation officielle de D2lang
rag: {
  shape: ellipse
  style.stroke: darkgreen
  style.fill: lightgreen
  style.stroke-width: 2
  label: "RAG alimenté par la documentation officielle de D2lang"
}

# Modèle Vision LLM (Pixtral)
vision_llm: {
  shape: ellipse
  style.stroke: darkorange
  style.fill: lightorange
  style.stroke-width: 2
  label: "Modèle Vision LLM (Pixtral)"
}

# Flux de processus pour le pipeline de traduction
pipeline -> mistral: "Utiliser le modèle de langage Mistral (Codestral)"
mistral -> rag: "Alimenter le RAG avec la documentation officielle de D2lang"
rag -> vision_llm: "Vérifier la cohérence visuelle avec le modèle Vision LLM (Pixtral)"
vision_llm -> pipeline: "Feedback pour amélioration continue"