direction: right

pipeline: {
  shape: rectangle
  label: "Pipeline de génération de diagrammes D2"
  style: {
    fill: "#f0f0f0"
    stroke: "#333"
    stroke-width: 2
  }
}

mistral_model: {
  shape: rectangle
  label: "Modèle Mistral (Codestral)"
  style: {
    fill: "#e6f7ff"
    stroke: "#1890ff"
    stroke-width: 2
  }
}

pixtral_model: {
  shape: rectangle
  label: "Modèle Vision LLM (Pixtral)"
  style: {
    fill: "#fff2e6"
    stroke: "#fa8c16"
    stroke-width: 2
  }
}

rag_system: {
  shape: rectangle
  label: "Système RAG"
  style: {
    fill: "#f6ffed"
    stroke: "#52c41a"
    stroke-width: 2
  }
}

d2_docs: {
  shape: rectangle
  label: "Documentation officielle D2lang"
  style: {
    fill: "#fff0f6"
    stroke: "#eb2f96"
    stroke-width: 2
  }
}

text_input: {
  shape: rectangle
  label: "Texte d'entrée"
  style: {
    fill: "#f0f5ff"
    stroke: "#1890ff"
    stroke-width: 2
  }
}

diagram_output: {
  shape: rectangle
  label: "Diagramme D2 généré"
  style: {
    fill: "#f0f5ff"
    stroke: "#1890ff"
    stroke-width: 2
  }
}

visual_check: {
  shape: rectangle
  label: "Vérification visuelle"
  style: {
    fill: "#fff7e6"
    stroke: "#faad14"
    stroke-width: 2
  }
}

feedback_loop: {
  shape: rectangle
  label: "Boucle de feedback"
  style: {
    fill: "#e6fffb"
    stroke: "#5cdbd3"
    stroke-width: 2
  }
}

pipeline -> mistral_model: "Utilise"
pipeline -> pixtral_model: "Utilise"
pipeline -> rag_system: "Alimente"
rag_system -> d2_docs: "Récupère des données"
text_input -> pipeline: "Fournit"
pipeline -> diagram_output: "Génère"
diagram_output -> pixtral_model: "Analyse"
pixtral_model -> visual_check: "Vérifie"
visual_check -> feedback_loop: "Retourne des résultats"
feedback_loop -> pipeline: "Améliore"