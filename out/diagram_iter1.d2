direction: right

input_layer: {
  shape: circle
  label: "Input Layer"
  width: 100
  height: 100
  style: {
    fill: "#FFD700"
    stroke: "#FFD700"
  }
}

hidden_layer: {
  shape: circle
  label: "Hidden Layer"
  width: 100
  height: 100
  style: {
    fill: "#87CEEB"
    stroke: "#87CEEB"
  }
}

output_layer: {
  shape: circle
  label: "Output Layer"
  width: 100
  height: 100
  style: {
    fill: "#90EE90"
    stroke: "#90EE90"
  }
}

input_layer -> hidden_layer: {
  style: {
    stroke: "#000000"
    stroke-dash: 5
  }
}

hidden_layer -> output_layer: {
  style: {
    stroke: "#000000"
    stroke-dash: 5
  }
}

