direction: right

network: {
  shape: rectangle
  label: "Network"
  style.stroke: blue
  style.fill: lightblue
  style.stroke-width: 2

  input_layer: {
    shape: oval
    label: "Input Layer"
    style.stroke: yellow
    style.fill: lightyellow
    style.stroke-width: 2

    n1: "Neuron 1"
    n2: "Neuron 2"
    n3: "Neuron 3"
    n4: "Neuron 4"
  }

  hidden_layer: {
    shape: oval
    label: "Hidden Layer"
    style.stroke: blue
    style.fill: lightblue
    style.stroke-width: 2

    n1: "Neuron 1"
    n2: "Neuron 2"
    n3: "Neuron 3"
    n4: "Neuron 4"
    n5: "Neuron 5"
  }

  output_layer: {
    shape: oval
    label: "Output Layer"
    style.stroke: green
    style.fill: lightgreen
    style.stroke-width: 2

    n1: "Neuron 1"
  }

  input_layer -> hidden_layer: {
    style.stroke: black
    style.stroke-width: 1
  }

  hidden_layer -> output_layer: {
    style.stroke: black
    style.stroke-width: 1
  }
}