direction: right

authentication_flow: {
  user: {
    shape: person
    label: "User"
  }

  login_page: {
    shape: document
    label: "Login Page"
  }

  credentials: {
    shape: document
    label: "Credentials"
  }

  auth_server: {
    shape: cloud
    label: "Auth Server"
  }

  session_token: {
    shape: document
    label: "Session Token"
  }

  protected_resource: {
    shape: document
    label: "Protected Resource"
  }

  user -> login_page: "Access"
  login_page -> credentials: "Submit"
  credentials -> auth_server: "Authenticate"
  auth_server -> session_token: "Issue"
  session_token -> protected_resource: "Access"
}