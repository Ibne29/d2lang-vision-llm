direction: right

# Pipeline de génération de diagrammes D2

## Modèle de langage Mistral (Codestral)
codestral: {
  shape: oval
  style: {
    fill: "#f0f0f0"
    stroke: "#333"
  }
  label: "Modèle de langage Mistral (Codestral)"
}

## RAG avec documentation D2lang
rag: {
  shape: cylinder
  style: {
    fill: "#e0e0ff"
    stroke: "#333"
  }
  label: "RAG avec documentation D2lang"
}

## Modèle Vision LLM (Pixtral)
pixtral: {
  shape: oval
  style: {
    fill: "#ffd0d0"
    stroke: "#333"
  }
  label: "Modèle Vision LLM (Pixtral)"
}

## Entrée de texte
texte: {
  shape: document
  style: {
    fill: "#d0ffd0"
    stroke: "#333"
  }
  label: "Entrée de texte"
}

## Diagramme généré
diagramme: {
  shape: document
  style: {
    fill: "#ffffd0"
    stroke: "#333"
  }
  label: "Diagramme généré"
}

## Vérification de cohérence
verification: {
  shape: diamond
  style: {
    fill: "#d0d0ff"
    stroke: "#333"
  }
  label: "Vérification de cohérence"
}

# Connexions
texte -> codestral: "Génération de texte"
codestral -> rag: "Enrichissement avec RAG"
rag -> diagramme: "Génération de diagramme"
diagramme -> pixtral: "Analyse visuelle"
pixtral -> verification: "Vérification"
verification -> texte: "Retour d'information"
verification -> diagramme: "Validation"