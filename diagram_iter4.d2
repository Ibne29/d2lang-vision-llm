direction: right

# Pipeline de génération de diagrammes avec D2lang

## Modèle de langage Mistral (Codestral)
Mistral: {
  shape: circle
  style: {
    fill: "#f0f0f0"
    stroke: "#333"
    stroke-width: 2
  }
}

## RAG avec documentation D2lang
RAG: {
  shape: database
  style: {
    fill: "#e0e0ff"
    stroke: "#333"
    stroke-width: 2
  }
}

## Modèle Vision LLM (Pixtral)
Pixtral: {
  shape: hexagon
  style: {
    fill: "#ffe0e0"
    stroke: "#333"
    stroke-width: 2
  }
}

## Flux du pipeline
Mistral -> RAG: "Génération de texte"
RAG -> Mistral: "RAG"
Mistral -> Pixtral: "Diagramme généré"
Pixtral -> Mistral: "Vérification visuelle"

# Légende
legend: {
  position: bottom
  items: [
    { id: Mistral, label: "Modèle de langage Mistral (Codestral)" },
    { id: RAG, label: "RAG avec documentation D2lang" },
    { id: Pixtral, label: "Modèle Vision LLM (Pixtral)" },
  ]
}